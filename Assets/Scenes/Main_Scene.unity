--- !u!1001 &1254437162
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[0].text
      value: "Tema: \u201CGarden of Knowledge: A Laboratory for a Future Society\u201D
        \u2014 fondendo l\u2019eredit\xE0 storica (Giardini della via della seta)
        con la visione futura e sostenibile."
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[1].text
      value: "Architettura: progetto di Atelier Br\xFCckner; base in mattoni/clay,
        livello superiore in colonnato di sugi\u2013legno di cedro locale, con forma
        triangolare che evoca il tumar (amuleto)."
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[2].text
      value: "Allestimento: tre zone tematiche \u2013 educazione, innovazione, energia
        pulita \u2013 e una piattaforma centrale che si muove lentamente avvolta
        da media a 360\xB0."
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[3].text
      value: "Materiali & sostenibilit\xE0: legno locale, mattoni riciclati, NFC
        su colonne per tracciabilit\xE0; dopo l\u2019Expo, il padiglione verr\xE0
        smontato e ricostruito in Uzbekistan \u2013 su modello di studio/scuola/cultura."
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[4].text
      value: "Eventi: ospiti come l\u2019Orchestra Sinfonica Nazionale uzbeka, performance
        di danza, oltre 100.000 visitatori gi\xE0 registrati."
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[3].duration
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 964353396636857705, guid: 284b6a20c2368d64c8dd495168ab92e3, type: 3}
      propertyPath: subtitles.Array.data[4].duration
      value: 5
      objectReference: {fileID: 0}
