    - target: {fileID: 9152036745893481038, guid: 2b88acc6cda07e94e9549f2037baa272, type: 3}
      propertyPath: subtitles.Array.data[0].text
      value: "Tema: un \u201Claboratorio della bellezza\u201D che unisce artigianato,
        sostenibilit\xE0 e innovazione."
      objectReference: {fileID: 0}
    - target: {fileID: 9152036745893481038, guid: 2b88acc6cda07e94e9549f2037baa272, type: 3}
      propertyPath: subtitles.Array.data[1].text
      value: "Architettura: progettato da Mario Cucinella Architects, presenta un
        tetto sinuoso di materiali riciclati e bio\u2010compositi, simbolo di tradizione
        e innovazione."
      objectReference: {fileID: 0}
    - target: {fileID: 9152036745893481038, guid: 2b88acc6cda07e94e9549f2037baa272, type: 3}
      propertyPath: subtitles.Array.data[2].text
      value: "Spazi: tre sezioni interiori \u2013 Teatro, Citt\xE0 ideale e Giardino
        italiano \u2013 narrano una storia di bellezza, arte, e sostenibilit\xE0."
      objectReference: {fileID: 0}
    - target: {fileID: 9152036745893481038, guid: 2b88acc6cda07e94e9549f2037baa272, type: 3}
      propertyPath: subtitles.Array.data[2].duration
